# dependencies (any level — workspaces get their own node_modules)
node_modules
.pnp

# testing
/coverage

# build (any level — apps/web/dist, future api dists)
dist
build
# CDK synth output (generated template + the asset copy)
cdk.out

# env
.env
.env.development
.env.local
.env.*.local
