infra/cdk/.env.*
!infra/cdk/.env.example

# local stack state (scripts/stack-up.sh): SeaweedFS data dir, pids, logs
.stack/

# misc
.DS_Store
*.log

# Vite
apps/web/src/assets/*/*.map
apps/web/public/*/*.map

