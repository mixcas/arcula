{"nodes": [{"id": "docs_agents_issue_tracker_gh_cli", "label": "GitHub Issues via gh CLI", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issues and specs live as GitHub issues; the repo is inferred from git remote -v and gh does this automatically inside a clone."}, {"id": "docs_agents_issue_tracker_prs_as_requests_no", "label": "PRs as a Request Surface: No", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External PRs are not feature requests in this repo, so /triage does not run them through the issue labels; the flag is read by the triage skill."}, {"id": "docs_agents_issue_tracker_sub_issues", "label": "Sub-Issues and Part-of Lines", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_agents_issue_tracker_shared_number_space", "label": "Shared Issue/PR Number Space", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub shares one number space across issues and PRs, so a bare #42 may be either and is resolved with gh pr view then gh issue view."}, {"id": "docs_agents_issue_tracker_wayfinding", "label": "Wayfinding Map and Child Tickets", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A wayfinder map is a single issue labelled wayfinder:map holding Notes / Decisions-so-far / Fog, with child tickets linked as sub-issues and labelled wayfinder:<type>; there is one frontier quer