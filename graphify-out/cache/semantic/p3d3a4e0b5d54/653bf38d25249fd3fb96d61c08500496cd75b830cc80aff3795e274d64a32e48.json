{"nodes": [{"id": "apps_api_readme_arcula_api", "label": "@arcula/api Backend", "file_type": "document", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_readme_bun_and_lambda_entry_points", "label": "Bun and Lambda Entry Points", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One app runs on Bun locally (Bun.serve on PORT 8000) and on a Node 24 Lambda in production; the lambda adapter carries Set-Cookie in the top-level cookies array (not multiValueHeaders) and base64-encodes binary bodies."}, {"id": "apps_api_readme_hono_app", "label": "Hono App (app.ts)", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns the onError error envelope, the www-to-configured-origin 308 redirect, dev-origin CORS, GET /api/health, and the mounts (/api/auth, /api/v1, then the SPA)."}, {"id": "apps_api_readme_spa_middleware", "label": "SPA Serving Middleware (spa.ts)", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serves index.html for every non-/api path (deep links included); index.html is never cached, hashed assets are immutable, and a missing dist tree leaves the middleware inert so Vite is the SPA in dev."}, {"id": "apps_api_readme_error_envelope", "label": "Uniform Error Envelope", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All /api/v1 responses share one envelope so clients parse one shape; Better Auth's /api/auth/* is deliberately unwrapped because its response shape is what @better-auth/react consumes."}, {"id": "apps_api_readme_resource_api", "label": "/api/v1 Resource API", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_readme_single_transaction_save", "label": "Single-Transaction Save with Accepted Residual", "file_type": "rationale", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A save is one Postgres transaction (field write, staged-to-final S3 copy, row upserts, deletes for dropped entries). S3 copies cannot roll back with the rows, so a failed save may leave final objects with no row \u2014 an accepted residual that the staging lifecycle and the sweep route exist to clean up."}, {"id": "apps_api_readme_access_ts_verdicts", "label": "Pure Access Verdicts (access.ts)", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure functions over the collection, the viewer's membership and the row, so the authorization truth can be reasoned about and tested without HTTP or database."}, {"id": "apps_api_readme_authorize_ts", "label": "Membership Loading (authorize.ts)", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loads the collection and the viewer's membership row for every read; every write path asks the same membership question via requireMemberCollection / requireMemberArtwork so non-members get 403 and missing collections 404."}, {"id": "apps_api_readme_deleted_view", "label": "Deleted Works View", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists works carrying a deletion stamp, most recently deleted first, restores one or several; it is member-only, even on a public collection."}, {"id": "apps_api_readme_owner_name_and_role", "label": "role / ownerName on GET /collections", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owned and shared collections come back together name-ordered, each row carrying role and a shared row the owner's display name; the dashboard cap counter counts owned collections only so a collaboration does not consume quota."}, {"id": "apps_api_readme_invitation_loop", "label": "Invitation Loop", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POST /collections/:id/invitations writes a pending row and mails CLIENT_ORIGIN/invite/:token; the raw token is never stored (only its SHA-256 hash) and acceptance needs both the token and a session whose email matches."}, {"id": "apps_api_readme_access_read", "label": "Access Read (GET /collections/:id/access)", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Member-readable: the caller's role, owner and collaborators go to every member, while pending invitations (expired included) go to the owner alone."}, {"id": "apps_api_readme_invitation_resend", "label": "Invitation Resend Rotation", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resend rotates token, expiry and issue time on the same pending row, at most once every 60 seconds; revoke records the resolution."}, {"id": "apps_api_readme_invitee_inbox", "label": "Invitee Inbox (GET /me/invitations)", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists pending, unexpired offers for the caller's own address with the collection name and inviter display name \u2014 never a token and never the inviter's address; in-app decline answers not-found for anything that is not the caller's own live offer."}, {"id": "apps_api_readme_access_ending", "label": "Access Ending: Removal and Leaving", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both delete the membership row so the account is a visitor on the next request and discard that account's staging prefix best effort \u2014 a storage failure does not fail the action, since the staging lifecycle is the backstop; saved works and final objects are untouched."}, {"id": "apps_api_readme_ownership_transfer", "label": "Ownership Transfer", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target must already be a collaborator; one transaction moves collections.userId, mirrors artworks.userId, removes the recipient's membership row and inserts the previous owner's. The fixed media namespace means no object moves and every existing URL keeps serving; the notice mail is sent after commit and emailSent:false never undoes the transfer."}, {"id": "apps_api_readme_password_write", "label": "Password Write on PATCH /collections/:id", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "password has three meanings \u2014 a string sets it (eight characters minimum, deliberately not trimmed), null removes it, an absent key leaves the column alone (so public\u2192private\u2192public returns to Protected). Plaintext is scrypt-hashed with cost parameters encoded in the stored string before the transaction; the settings write and the deletion of every Access grant row commit together so a password change never leaves a reader holding a grant to the old password. The hash is never a wire field."}, {"id": "apps_api_readme_is_password_protected", "label": "isPasswordProtected", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On every member-audience collection document, derived from the hash's presence; a visitor's document does not carry the field at all, not even false. The anonymous GET /collections omits a Protected collection exactly as it omits a Private one, so it is reachable only by direct link."}, {"id": "apps_api_readme_password_required_challenge", "label": "403 password-required Challenge", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A refused collection read is 403 password-required with details.collectionName so the public pages can fold to the lock screen; a refused work list is 403 forbidden and a single work or photo object is 404, because only the collection read is the challenge."}, {"id": "apps_api_readme_unlock_route", "label": "POST /collections/:id/unlock", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts any non-empty guess (a short guess is a wrong password, not a malformed request). Right password \u2192 201 {unlocked:true} plus the grant cookie; wrong \u2192 403 invalid-password, deliberately distinct from an invitation token's uniform not-found because the lock screen already named the collection; no password or a Private collection \u2192 409; unknown \u2192 404. A grant admits exactly what a visitor sees."}, {"id": "apps_api_readme_grant_cookie", "label": "arcula_grant_{collectionId} Cookie", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HttpOnly, SameSite=Lax, Path=/api/v1, Max-Age=43200, Secure in production; a 32-byte random token whose SHA-256 hash is the only stored form, with the same twelve-hour expiry so the cookie lapses when the row does. The cookie name is its scope \u2014 each route reads only its collection's name and looks up by collection id and token hash \u2014 so the broad path does not admit one collection's grant to another's reads."}, {"id": "apps_api_readme_unlock_throttle", "label": "Unlock Throttle", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counted in collection_unlock_attempts per address, collection and fixed ten-minute window floored from the attempt's own time; ten failures spend the window and the eleventh is refused unread as 429 too-many-attempts. The refusal states the window not the time left and sends no Retry-After; a right password deletes the counter rows so a mistyping member carries no debt; keying on the pair stops one collection's throttle locking a shared address out of another's."}, {"id": "apps_api_readme_client_address_header", "label": "x-arcula-client-ip Address", "file_type": "concept", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The throttle's address is the gateway's sourceIp written by the Lambda entry, never read from a client-supplied forwarding header, so a client cannot choose the bucket it is counted in."}, {"id": "apps_api_readme_collection_password_module", "label": "collectionPassword.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hashPassword (scrypt with cost encoded in the string) and verifyPassword; no plaintext is stored or logged and a malformed hash is a failed check, not a 500."}, {"id": "apps_api_readme_collection_grants_module", "label": "collectionGrants.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The grant's pure facts \u2014 32-byte token, SHA-256 hash, cookie name and path, twelve-hour lifetime, usability \u2014 with no database and no Hono so the minting route and the reading routes share one definition."}, {"id": "apps_api_readme_unlock_throttle_module", "label": "unlockThrottle.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds only the throttle's policy \u2014 the fixed ten-minute window and the flooring that names the span an attempt belongs to."}, {"id": "apps_api_readme_artwork_read_module", "label": "artworkRead.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single read path for works, one and listed, with the access verdict applied over the rows it loads; it carries no HTTP type because the route owns the wire codes."}, {"id": "apps_api_readme_invitations_module", "label": "invitations.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_readme_media_key_algebra", "label": "media/keys.ts Object-Key Algebra", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The key parser is what makes the media proxy's per-request authorization work from the key alone; with sharing, final keys use the collection's fixed mediaNamespaceId and staging keys use the uploader's id."}, {"id": "apps_api_readme_media_pipeline", "label": "media/pipeline.ts (Sharp)", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_readme_variant_geometry", "label": "media/variants.ts Variant Geometry", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One table drives the encoder, the tests and the key algebra, so geometry cannot drift between them."}, {"id": "apps_api_readme_media_promote", "label": "media/promote.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_readme_media_populations", "label": "media/populations.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One record states what differs between Photos and documents \u2014 caps, accepted types, entry table, variant specs, key shape, whether a non-image is admissible \u2014 so a new population is data rather than branching."}, {"id": "apps_api_readme_storage_client", "label": "storage.ts S3 Client", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "S3_ENDPOINT is required and it refuses to fall through to AWS's default, so a misconfigured environment fails loudly instead of silently writing to the wrong account; credentials come from S3_ACCESS_KEY/S3_SECRET_KEY in dev and the Lambda's IAM role in production."}, {"id": "apps_api_readme_email_provider", "label": "email/provider.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SMTP locally and Resend in production; a provider failure surfaces as emailSent:false rather than failing the write."}, {"id": "apps_api_readme_serialize_module", "label": "serialize.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_api_readme_response_policy", "label": "responsePolicy.ts", "file_type": "code", "source_file": "apps/api/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Environment-derived response decisions as pure functions (canonical-host redirect, health body, noindex flag); env.ts reads the inputs once and the app hands them in, so no environment's hostname or commit is written into the source."}], "edges": [{"source": "apps_api_readme_arcula_api", "target": "apps_api_readme_hono_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_arcula_api", "target": "apps_api_readme_bun_and_lambda_entry_points", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_bun_and_lambda_entry_points", "target": "apps_api_readme_hono_app", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_hono_app", "target": "apps_api_readme_error_envelope", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_hono_app", "target": "apps_api_readme_resource_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_hono_app", "target": "apps_api_readme_spa_middleware", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_spa_middleware", "target": "apps_web_index_html_entry", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_hono_app", "target": "apps_api_readme_response_policy", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_resource_api", "target": "apps_api_readme_error_envelope", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_resource_api", "target": "apps_api_readme_single_transaction_save", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/api/README.md", "source_location": null, "weight": 1.0}, {"source": "apps_api_readme_single_transaction_save", "target": "apps_api_readme_media_promote", "relation": "references", "confidence": "EXTRACTED", "c