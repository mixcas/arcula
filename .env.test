# Test-mode env (Vite/vitest "test" mode only — never loaded by dev or build).
#
# The web test suites that import `src/services/firebase.ts` need the
# VITE_FIREBASE_* vars to exist at module load (the SDK initializes on
# import). These are the EMULATOR values: the rules suites run under
# `firebase emulators:exec --project demo-custodia` (test:rules), which
# points the SDK at the local emulators via FIRESTORE_EMULATOR_HOST /
# FIREBASE_AUTH_EMULATOR_HOST / STORAGE_EMULATOR_HOST, so no real project
# is ever contacted from the test suite. The apiKey is a placeholder the
# emulators accept.
#
# In test mode this file overrides `.env`, so restoring the real VITE_*
# values to `.env` for the dev app cannot leak into the suites.

VITE_FIREBASE_API_KEY=AIzaSyEmulator-TEST-KEY-0000000000
VITE_FIREBASE_AUTH_DOMAIN=demo-custodia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-custodia
VITE_FIREBASE_STORAGE_BUCKET=demo-custodia.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:100000000000:web:emulator
